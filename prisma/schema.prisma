generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String             @id @default(uuid())
  name             String
  email            String             @unique
  password         String
  role             String             @default("member")
  initials         String
  color            String
  bio              String             @default("")
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime           @default(now())
  deletedAt        DateTime?
  tasks            Task[]             @relation("TaskAssignee")
  createdTasks     Task[]             @relation("TaskCreator")
  projects         ProjectMember[]
  sessions         Session[]
  notifications    Notification[]
  notifSettings    UserNotifSettings?
}

model UserNotifSettings {
  id           String  @id @default(uuid())
  userId       String  @unique
  newProject   Boolean @default(true)
  taskAssigned Boolean @default(true)
  taskComment  Boolean @default(true)
  deployDone   Boolean @default(true)
  weeklyDigest Boolean @default(true)
  clientUpdate Boolean @default(true)
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id          String    @id @default(uuid())
  jti         String    @unique
  userId      String
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Workspace {
  id          String   @id @default(uuid())
  name        String   @default("Ascurra Soluciones")
  timezone    String   @default("America/Argentina/Buenos_Aires")
  language    String   @default("es")
  inviteToken String   @unique @default(cuid())
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model Project {
  id           String        @id @default(uuid())
  name         String
  stack        String
  status       ProjectStatus @default(active)
  progress     Int           @default(0)
  updatedAt    DateTime      @updatedAt
  createdAt    DateTime      @default(now())
  deletedAt    DateTime?
  tasks   Task[]
  members ProjectMember[]
  clients ClientProject[]
}

enum ProjectStatus {
  active
  completed
  paused
}

model ProjectMember {
  projectId String
  userId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

model Task {
  id            String    @id @default(uuid())
  projectId     String
  title         String
  description   String    @default("")
  priority      Priority  @default(medium)
  column        Column    @default(backlog)
  labels        String[]
  dueDate       String?
  subtasksDone  Int       @default(0)
  subtasksTotal Int       @default(0)
  assigneeId    String?
  createdById   String?
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee      User?     @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy     User?     @relation("TaskCreator", fields: [createdById], references: [id])
}

enum Priority {
  low
  medium
  high
  critical
}

enum Column {
  backlog
  progress
  review
  done
}

model Client {
  id            String        @id @default(uuid())
  company       String
  industry      String
  contactName   String
  contactEmail  String
  status        ClientStatus  @default(prospect)
  contractSince String?
  lastActivity  DateTime      @default(now())
  initials      String
  color         String
  createdAt     DateTime      @default(now())
  deletedAt     DateTime?
  projects      ClientProject[]
}

enum ClientStatus {
  active
  prospect
  inactive
}

model ClientProject {
  clientId  String
  projectId String
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([clientId, projectId])
}

model AppError {
  id              String          @id @default(uuid())
  errorConfigId   String?
  type            String
  message         String
  severity        ErrorSeverity   @default(error)
  status          ErrorStatus     @default(unresolved)
  count           Int             @default(1)
  usersAffected   Int             @default(0)
  stackTrace      String          @default("")
  firstSeen       DateTime        @default(now())
  lastSeen        DateTime        @default(now())
  metaUrl         String          @default("")
  metaBrowser     String          @default("")
  metaOs          String          @default("")
  metaUser        String          @default("")
  createdAt       DateTime        @default(now())
  deletedAt       DateTime?
  errorConfig     ErrorConfig?    @relation(fields: [errorConfigId], references: [id])
  occurrences     ErrorOccurrence[]
}

enum ErrorSeverity {
  critical
  error
  warning
}

enum ErrorStatus {
  unresolved
  resolved
  ignored
}

model ErrorOccurrence {
  id        String   @id @default(uuid())
  errorId   String
  userId    String?
  url       String?
  browser   String?
  os        String?
  createdAt DateTime @default(now())
  error     AppError @relation(fields: [errorId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String   @default("")
  entityId  String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApiKey {
  id           String             @id @default(uuid())
  name         String
  keyHash      String             @unique
  prefix       String
  createdAt    DateTime           @default(now())
  revokedAt    DateTime?
  errorConfigs ErrorConfig[]
  arcaConfigs  ArcaConfigApiKey[]
}

model ErrorConfig {
  id        String     @id @default(uuid())
  name      String
  apiKeyId  String?
  createdAt DateTime   @default(now())
  apiKey    ApiKey?    @relation(fields: [apiKeyId], references: [id])
  errors    AppError[]
}

model Prospect {
  id             String         @id @default(uuid())
  name           String
  industry       String         @default("")
  city           String
  address        String         @default("")
  phone          String         @default("")
  website        String         @default("")
  hours          String         @default("")
  socialMedia    String         @default("")
  hasWebsite     Boolean        @default(false)
  hasSocialMedia Boolean        @default(false)
  rating         Float          @default(0)
  reviewCount    Int            @default(0)
  score          Int            @default(0)
  scoreLabel     String         @default("baja")
  stage          ProspectStage  @default(new)
  notes          String         @default("")
  googleId       String?        @unique
  createdAt      DateTime       @default(now())
}

enum ProspectStage {
  new
  contacted
  interested
  discarded
}

model MailConfig {
  id        String         @id @default(uuid())
  name      String         @unique
  host      String
  port      Int
  user      String
  pass      String
  from      String
  apiKeyId  String?
  templates MailTemplate[]
  logs      MailLog[]
  updatedAt DateTime       @updatedAt
  createdAt DateTime       @default(now())
}

model MailTemplate {
  id        String     @id @default(uuid())
  configId  String
  config    MailConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  name      String
  subject   String
  html      String
  params    String[]
  updatedAt DateTime   @updatedAt
  createdAt DateTime   @default(now())

  @@unique([configId, name])
}

model MailLog {
  id           String     @id @default(uuid())
  configId     String
  config       MailConfig @relation(fields: [configId], references: [id])
  to           String
  subject      String
  templateName String     @default("")
  status       String     @default("sent")
  error        String     @default("")
  messageId    String     @default("")
  createdAt    DateTime   @default(now())
}

model ArcaConfig {
  id                   String             @id @default(uuid())
  name                 String             @unique
  cuit                 String
  cert                 String
  privateKey           String
  production           Boolean            @default(false)
  certExpiryNotifiedAt DateTime?
  apiKeys              ArcaConfigApiKey[]
  logs                 ArcaLog[]
  updatedAt            DateTime           @updatedAt
  createdAt            DateTime           @default(now())
}

model ArcaConfigApiKey {
  id        String     @id @default(uuid())
  configId  String
  apiKeyId  String     @unique
  config    ArcaConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  apiKey    ApiKey     @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@index([configId])
}

model ArcaLog {
  id             String     @id @default(uuid())
  configId       String
  config         ArcaConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  service        String
  method         String
  request        String
  response       String
  status         String     @default("ok")
  error          String     @default("")
  durationMs     Int        @default(0)
  idempotencyKey String?    @unique
  updatedAt      DateTime   @updatedAt
  createdAt      DateTime   @default(now())

  @@index([configId, createdAt(sort: Desc)])
}

model MercadoPagoConfig {
  id             String           @id @default(uuid())
  name           String           @unique
  accessToken    String
  publicKey      String
  webhookUrl     String           @default("")
  backUrlSuccess String           @default("")
  backUrlFailure String           @default("")
  backUrlPending String           @default("")
  apiKeyId       String?
  logs           MercadoPagoLog[]
  updatedAt      DateTime         @updatedAt
  createdAt      DateTime         @default(now())
}

model MercadoPagoLog {
  id                String            @id @default(uuid())
  configId          String
  config            MercadoPagoConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  externalReference String            @default("")
  preferenceId      String            @default("")
  paymentId         String            @default("")
  checkoutUrl       String            @default("")
  status            String            @default("pending")
  amount            Float             @default(0)
  currency          String            @default("ARS")
  error             String            @default("")
  updatedAt         DateTime          @updatedAt
  createdAt         DateTime          @default(now())
}

enum WhatsAppMessageDirection {
  sent
  received
}

model WhatsAppConfig {
  id                 String            @id @default(uuid())
  name               String            @unique
  phoneNumberId      String
  accessToken        String
  webhookVerifyToken String
  businessAccountId  String?
  apiKeyId           String?
  messages           WhatsAppMessage[]
  logs               WhatsAppLog[]
  updatedAt          DateTime          @updatedAt
  createdAt          DateTime          @default(now())
}

model WhatsAppMessage {
  id        String                   @id @default(uuid())
  configId  String
  config    WhatsAppConfig           @relation(fields: [configId], references: [id], onDelete: Cascade)
  direction WhatsAppMessageDirection
  from      String
  to        String
  body      String
  type      String                   @default("text")
  wamid     String                   @default("")
  status    String                   @default("sent")
  error     String                   @default("")
  createdAt DateTime                 @default(now())
}

model ContactRequest {
  id        String               @id @default(uuid())
  phone     String
  email     String
  message   String
  status    ContactRequestStatus @default(new)
  createdAt DateTime             @default(now())
}

enum ContactRequestStatus {
  new
  read
  archived
}

model WhatsAppLog {
  id         String         @id @default(uuid())
  configId   String
  config     WhatsAppConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  method     String
  request    String
  response   String
  status     String
  error      String         @default("")
  durationMs Int
  createdAt  DateTime       @default(now())
}

model RequestLog {
  id           String   @id @default(uuid())
  method       String
  path         String
  statusCode   Int
  ipAddress    String?
  requestBody  String?
  responseBody String?
  errorMessage String?
  durationMs   Int?
  createdAt    DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}

// ── Instagram Generator ───────────────────────────────────────────────────────

model Brand {
  id            String          @id @default(uuid())
  name          String
  industry      String          @default("")
  acknowledge   String          @default("")
  voice         String          @default("")
  colorPalette  Json            @default("[]")
  typography    Json            @default("{}")
  logoUrl       String          @default("")
  igUserId      String          @default("")
  igAccessToken String          @default("")
  openAiApiKey  String          @default("")
  openAiModel   String          @default("")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  examples      IgExamplePost[]
  templates     IgTemplate[]
  posts         IgPost[]
  batchJobs     IgBatchJob[]
  learning      BrandLearning?
}

model IgExamplePost {
  id        String   @id @default(uuid())
  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  imageUrl  String   @default("")
  caption   String
  createdAt DateTime @default(now())
}

model IgTemplate {
  id            String     @id @default(uuid())
  brandId       String
  brand         Brand      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name          String
  html          String
  variables     String[]
  summary       String     @default("")
  summaryStatus String     @default("pending")
  isAiGenerated Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  posts         IgPost[]
}

model IgPost {
  id                String       @id @default(uuid())
  brandId           String
  brand             Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  templateId        String?
  template          IgTemplate?  @relation(fields: [templateId], references: [id])
  batchJobId        String?
  batchJob          IgBatchJob?  @relation(fields: [batchJobId], references: [id])
  caption           String
  hashtags          String[]
  variables         Json         @default("{}")
  status            IgPostStatus @default(draft)
  approvedById      String?
  approvedAt        DateTime?
  rejectedAt        DateTime?
  rejectReason      String       @default("")
  imageUrl          String?
  instagramMediaId  String?
  publishStatus     String       @default("unpublished")
  publishedAt       DateTime?
  igImpressions     Int          @default(0)
  igReach           Int          @default(0)
  igEngagement      Int          @default(0)
  igSaved           Int          @default(0)
  igSyncedAt        DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

enum IgPostStatus {
  generating
  draft
  approved
  rejected
}

model IgBatchJob {
  id               String     @id @default(uuid())
  brandId          String
  brand            Brand      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  openAiBatchId    String?
  prompt           String
  status           String     @default("pending")
  postCount        Int        @default(0)
  errorMessage     String     @default("")
  inputTokens      Int        @default(0)
  outputTokens     Int        @default(0)
  estimatedCostUsd Float      @default(0)
  posts            IgPost[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model IgCostLog {
  id               String   @id @default(uuid())
  brandId          String?
  operation        String
  entityId         String
  model            String   @default("gpt-4o-mini")
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  totalTokens      Int      @default(0)
  estimatedCostUsd Float    @default(0)
  requestCount     Int      @default(0)
  createdAt        DateTime @default(now())

  @@index([brandId, createdAt(sort: Desc)])
}

model BrandLearning {
  id            String    @id @default(uuid())
  brandId       String    @unique
  brand         Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  insights      String    @default("")
  insightStatus String    @default("pending")
  openAiBatchId String?
  totalApproved Int       @default(0)
  totalRejected Int       @default(0)
  lastSynthAt   DateTime?
  updatedAt     DateTime  @updatedAt
  createdAt     DateTime  @default(now())
}
