DATABASE_URL="postgresql://user:password@localhost:5432/ascurra_dev"
PORT=3000
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"
CORS_ALLOWED_ORIGINS="http://localhost:4200"
API_URL="http://localhost:3000"
APP_VERSION="local"

# Required for ARCA certificate/private-key encryption.
# Generate once per environment with: openssl rand -hex 32
# Keep the same value after configs are encrypted, or existing ARCA configs cannot be decrypted.
ARCA_ENCRYPTION_KEY="64-char-hex-string"
